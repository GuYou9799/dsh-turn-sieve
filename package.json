{
  "name": "dsh-turn-sieve",
  "version": "1.2.0",
  "description": "Turn Sieve · 回合筛 — prune low-value parts of a DeepSeek Harness chat in place: sieve a whole exchange, only your prompt, only the reply, a single message, or in-turn notice cards (stopped / failed / retried / compacted); ✓ confirms, ✕ cancels, no dialog, and one undo restores it. 1.2.0 fixes a bug that could make a session's log unreadable and ships scripts/audit-session.mjs to audit and repair such logs. 在对话里原位筛除低价值问答或单条消息，✓ 确认 ✕ 取消、全程不弹窗，可随时撤销；1.2.0 修好了会让会话日志损坏、整段对话打不开的缺陷，并附带会话审计与修复脚本。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/sieve.test.mjs && node test/docs.test.mjs && node test/client-load.mjs",
    "audit:session": "node scripts/audit-session.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-turn-sieve",
    "turn-sieve",
    "deepseek-harness",
    "deepseek",
    "context",
    "context-window",
    "context-management",
    "conversation",
    "conversation-management",
    "chat-history",
    "prune",
    "compact",
    "token-saving",
    "undo",
    "plugin",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuYou9799/dsh-turn-sieve.git"
  },
  "homepage": "https://github.com/GuYou9799/dsh-turn-sieve#readme",
  "bugs": {
    "url": "https://github.com/GuYou9799/dsh-turn-sieve/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "author": "Gu You",
  "license": "MIT"
}
