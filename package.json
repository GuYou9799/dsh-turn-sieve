{
  "name": "dsh-turn-sieve",
  "version": "0.4.0",
  "description": "Selectively remove low-value exchanges or individual messages from a DeepSeek Harness conversation, with a chat-anchored “sieve” action and undo, without starting a new session. 回合筛：按整段问答或单条消息清理当前会话，支持从原回复旁直接删除并撤销上一次删除。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/sieve.test.mjs && node test/client-load.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "conversation",
    "prune",
    "compact",
    "context-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuYou9799/dsh-turn-sieve.git"
  },
  "homepage": "https://github.com/GuYou9799/dsh-turn-sieve#readme",
  "bugs": {
    "url": "https://github.com/GuYou9799/dsh-turn-sieve/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "author": "Gu You",
  "license": "MIT"
}
